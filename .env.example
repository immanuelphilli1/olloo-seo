# Copy to .env — every key is optional; the app works without them.

# Public URL of THIS site (used in canonicals, sitemap, schema, crawler user agent)
SITE_URL=http://localhost:5180
# Product name (keep in sync with web/app/config/site.ts) and crawler token (no spaces)
SITE_NAME=olloo SEO
BOT_NAME=ollooSEOBot

# Claude API key: enables AI-written fixes (titles, meta descriptions, alt text, FAQs, action plan)
ANTHROPIC_API_KEY=
# Stop calling the AI after this much estimated spend per day (USD)
AI_DAILY_BUDGET_USD=2

# Google PageSpeed Insights API key (free) — raises Core Web Vitals quota
PAGESPEED_API_KEY=

# Cloudflare Turnstile captcha (off when empty)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Audits allowed per IP per day
AUDITS_PER_IP_PER_DAY=5

# Max Google autocomplete requests per day for the Keyword Generator (each lookup uses ~12,
# results are cached for 7 days). When reached, the tool shows built-in ideas only.
AUTOCOMPLETE_DAILY_LIMIT=2000

# Secret used to hash IP addresses — change in production
IP_HASH_SALT=change-me

# LOCAL TESTING ONLY: allow auditing localhost/private IPs (fixture sites). Never enable in production.
ALLOW_PRIVATE_TARGETS=false

# API server port
PORT=8787
